# 운영·배포용 환경변수. 이 파일을 engine.env 로 복사해 값을 채운다.
#   cp config/engine.env.example config/engine.env
# start.sh 가 자동으로 source 한다. engine.env 는 .gitignore 대상이다.
#
# 계정 변수명은 USERNAME 이다 (..._USER 는 바인딩되지 않는다).
ALERT_DB_URL=jdbc:postgresql://localhost:5432/dwjedb
ALERT_DB_USERNAME=dwje_local
ALERT_DB_PASSWORD=

# 메일 발송 (prod 프로파일에서 SMTP 모드일 때 필요)
PROD_MAIL_HOST=
PROD_MAIL_USERNAME=
PROD_MAIL_PASSWORD=
PROD_WEB_BASE_URL=https://ax.dwje.co.kr

# SSL 직접 연결을 사용하는 서버는 PORT=465, SSL_ENABLE=true, STARTTLS_ENABLE=false로 설정합니다.
PROD_MAIL_PORT=587
PROD_MAIL_SSL_ENABLE=false
PROD_MAIL_STARTTLS_ENABLE=true
PROD_MAIL_FROM=no-reply@dwje.co.kr
